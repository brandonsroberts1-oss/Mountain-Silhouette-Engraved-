{
  "name": "fall-line-studio",
  "version": "1.5.1",
  "description": "Search any ski area and design laser-ready SVG engravings of its trails, terrain and stats for xTool Studio.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node serve.mjs 8080",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:layout": "node tests/layout.mjs",
    "build-data": "node --max-old-space-size=6144 scripts/build-data.mjs --out data"
  },
  "license": "MIT"
}
